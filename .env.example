# Application
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# PostgreSQL
POSTGRES_USER=imageword
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=imageword
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=imageword
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=imageword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGNED_URL_TTL_SECONDS=300

# Upload
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000
GENERATION_MAX_GLYPHS=50000
VIDEO_FPS=20
VIDEO_MAX_COLUMNS=120
VIDEO_MAX_GLYPHS=12000
VIDEO_HOLD_SECONDS=1
FFMPEG_PATH=ffmpeg

# Authentication (used from Milestone 3)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
